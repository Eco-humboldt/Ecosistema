      </div>
    </section>
  </main>
</Layout>

<style>
  #solicitudes {
    background-image: url("img/flores.png");
  }
  .link-card-grid {
    display: flex;
    justify-content: space-around;
    align-items: center;
    border: 1px solid #000;
    margin: 1em auto;
    border-radius: 10em;
  }
  @media screen and (max-width: 767px) {
    .link-card-grid {
      flex-direction: column;
      border: none;
      margin: 0.5em auto;
    }
  }
</style>
